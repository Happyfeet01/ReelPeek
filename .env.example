# Nur diese vorab festgelegte Adresse kann das bestehende Betreiberkonto aktivieren.
ADMIN_EMAIL=
PUBLIC_BASE_URL=https://reelpeek.example.de
# SMTP mit STARTTLS
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=

# Angaben für Impressum und Datenschutzhinweise vor dem öffentlichen Betrieb eintragen.
OPERATOR_NAME=
OPERATOR_ADDRESS=
OPERATOR_EMAIL=
# Optionale weitere Impressumspflichten je nach Betreiber
IMPRINT_EXTRA=
# Hoster, Mailanbieter, Standorte, Drittlandtransfers/Garantien, Log- und Backupfristen
PRIVACY_OPERATIONS=
PRIVACY_AUTHORITY=

# Erzeugen mit: openssl rand -hex 32
SESSION_SECRET=hier-eine-zufaellige-64-stellige-zeichenfolge-eintragen

# Medien und Vorschaubilder ohne Favoriten nach 14 Tagen löschen; Verlauf bleibt erhalten.
# Die bisherige Einstellung CACHE_TTL_HOURS wird nicht mehr verwendet.
RETENTION_DAYS=14

# Bei rein lokalem HTTP-Test auf false setzen, im produktiven HTTPS-Betrieb true lassen
COOKIE_SECURE=true
